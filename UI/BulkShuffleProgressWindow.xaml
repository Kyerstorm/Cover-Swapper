<Window x:Class="PluginCoverShuffle.UI.BulkShuffleProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shuffle Games" Height="360" Width="440" MinHeight="300" MinWidth="360"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PluginCoverShuffle;component/UI/Resources/CoverShuffleTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="16" LastChildFill="True">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource CoverShuffleTitleTextStyle}" FontSize="16" Margin="0,0,0,14" />

        <!-- Running state: progress bar + N / M + Cancel. -->
        <StackPanel DockPanel.Dock="Top" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressBar Height="18" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" Margin="0,0,0,8" />
            <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Center" Style="{StaticResource CoverShuffleBodyTextStyle}" />
            <Button Content="Cancel" Padding="14,6" HorizontalAlignment="Right" Margin="0,16,0,0"
                    Click="CancelButton_Click" IsEnabled="{Binding CanCancel}" />
        </StackPanel>

        <!-- Completion state: structured summary + optional failure details + Close. -->
        <StackPanel DockPanel.Dock="Top" Visibility="{Binding IsComplete, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource CoverShuffleBodyTextStyle}" TextWrapping="Wrap" />

            <Button Content="View Details" Padding="10,4" HorizontalAlignment="Left" Margin="0,12,0,0"
                    Click="ViewDetailsButton_Click"
                    Visibility="{Binding HasFailures, Converter={StaticResource BoolToVisibilityConverter}}" />

            <Border Style="{StaticResource CoverShuffleDividerStyle}" Margin="0,12,0,10"
                    Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVisibilityConverter}}" />

            <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding DetailsText}" Style="{StaticResource CoverShuffleMutedTextStyle}" TextWrapping="Wrap" />
            </ScrollViewer>

            <Button Content="Close" Padding="14,6" HorizontalAlignment="Right" Margin="0,16,0,0"
                    Click="CloseButton_Click" IsDefault="True" IsCancel="True" />
        </StackPanel>
    </DockPanel>
</Window>
