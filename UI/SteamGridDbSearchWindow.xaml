<Window x:Class="PluginCoverShuffle.UI.SteamGridDbSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PluginCoverShuffle.UI"
        Title="Add Cover from SteamGridDB" Height="520" Width="640" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ui:AlreadyAddedLabelConverter x:Key="AlreadyAddedLabelConverter" />
        <ui:InverseBoolConverter x:Key="InverseBoolConverter" />
    </Window.Resources>
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox x:Name="SearchBox" Width="360" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="SearchBox_KeyDown" />
            <Button Content="Search" Width="80" Margin="8,0,0,0" Click="SearchButton_Click" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}" Margin="0,0,0,8" Opacity="0.8" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Results}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" Margin="4" Padding="4" Width="140">
                            <StackPanel>
                                <Image Source="{Binding PreviewUrl}" Width="130" Height="180" Stretch="Uniform" />
                                <Button Margin="0,4,0,0"
                                        Content="{Binding AlreadyAdded, Converter={StaticResource AlreadyAddedLabelConverter}}"
                                        IsEnabled="{Binding AlreadyAdded, Converter={StaticResource InverseBoolConverter}}"
                                        Click="AddButton_Click"
                                        Tag="{Binding}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
