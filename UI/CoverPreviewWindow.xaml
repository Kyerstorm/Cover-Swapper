<Window x:Class="PluginCoverShuffle.UI.CoverPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PluginCoverShuffle.UI"
        Title="Cover Preview" Height="560" Width="420" MinHeight="420" MinWidth="360"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PluginCoverShuffle;component/UI/Resources/CoverShuffleTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="16" LastChildFill="True">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding GameName}" Style="{StaticResource CoverShuffleTitleTextStyle}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="{Binding PositionText}" Style="{StaticResource CoverShuffleMutedTextStyle}" VerticalAlignment="Bottom" Margin="8,0,0,0"
                       Visibility="{Binding CanNavigate, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>

        <!-- Non-modal feedback for the last preview action (e.g. "Set as current cover."). -->
        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}" Style="{StaticResource CoverShuffleBodyTextStyle}" Opacity="0.8" Margin="0,0,0,8"
                   Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVisibilityConverter}}" />

        <Grid DockPanel.Dock="Top" MinHeight="260" MaxHeight="360" Margin="0,0,0,10">
            <Border CornerRadius="4" Background="{DynamicResource TextBrush}" Opacity="0.06">
                <Grid>
                    <Image Source="{Binding AbsoluteImagePath}" Stretch="Uniform"
                           Visibility="{Binding IsUnavailable, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                    <TextBlock Text="{Binding UnavailableReasonText}" TextWrapping="Wrap" TextAlignment="Center" Margin="16"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                               Visibility="{Binding IsUnavailable, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </Border>

            <!-- Previous/Next navigation, only shown when there is more than one cover to move between. -->
            <Button Content="&#8592; Previous" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0"
                    Padding="8,6" Click="PreviousButton_Click"
                    IsEnabled="{Binding CanMovePrevious}"
                    AutomationProperties.Name="Previous cover"
                    Visibility="{Binding CanNavigate, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Button Content="Next &#8594;" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0"
                    Padding="8,6" Click="NextButton_Click"
                    IsEnabled="{Binding CanMoveNext}"
                    AutomationProperties.Name="Next cover"
                    Visibility="{Binding CanNavigate, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>

        <StackPanel DockPanel.Dock="Top">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Source" Style="{StaticResource CoverShuffleSectionLabelTextStyle}" Width="110" />
                <TextBlock Grid.Column="1" Text="{Binding SourceText}" Style="{StaticResource CoverShuffleBodyTextStyle}" />
            </Grid>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Dimensions" Style="{StaticResource CoverShuffleSectionLabelTextStyle}" Width="110" />
                <TextBlock Grid.Column="1" Text="{Binding DimensionsText}" Style="{StaticResource CoverShuffleBodyTextStyle}" />
            </Grid>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Added" Style="{StaticResource CoverShuffleSectionLabelTextStyle}" Width="110" />
                <TextBlock Grid.Column="1" Text="{Binding AddedAtText}" Style="{StaticResource CoverShuffleBodyTextStyle}" />
            </Grid>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Usage" Style="{StaticResource CoverShuffleSectionLabelTextStyle}" Width="110" />
                <TextBlock Grid.Column="1" Text="{Binding UsageCountText}" Style="{StaticResource CoverShuffleBodyTextStyle}" />
            </Grid>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Status" Style="{StaticResource CoverShuffleSectionLabelTextStyle}" Width="110" />
                <TextBlock Grid.Column="1" Text="{Binding HealthStatus}" Style="{StaticResource CoverShuffleBodyTextStyle}" />
            </Grid>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Set as Current" Padding="14,6" Margin="0,0,8,0" Click="SetAsCurrentButton_Click"
                    IsEnabled="{Binding CanSetAsCurrent}" />
            <Button Content="Close" Padding="14,6" Click="CloseButton_Click" IsDefault="True" IsCancel="True" />
        </StackPanel>
    </DockPanel>
</Window>
