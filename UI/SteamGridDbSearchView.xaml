<UserControl x:Class="PluginCoverShuffle.UI.SteamGridDbSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:PluginCoverShuffle.UI"
             MinWidth="520" MinHeight="380">
    <UserControl.Resources>
        <ui:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <ui:InverseBoolConverter x:Key="InverseBoolConverter" />
        <ui:AlreadyAddedLabelConverter x:Key="AlreadyAddedLabelConverter" />

        <!--
            Cover cards use a ListBox so a single click anywhere in the item
            reliably selects it (an ItemsControl + Button per card, the
            previous approach, only responded to clicks on the button
            itself). The default ListBoxItem chrome is replaced so "selected"
            reads as a border + checkmark instead of a theme-specific
            highlight color we can't be sure exists in every Playnite theme.
        -->
        <Style x:Key="CoverCardStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleDescription}" />
            <Setter Property="IsEnabled" Value="{Binding AlreadyAdded, Converter={StaticResource InverseBoolConverter}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CardBorder" Width="150" BorderThickness="2" CornerRadius="4"
                                Background="Transparent">
                            <Grid>
                                <Border x:Name="InnerBackground" BorderThickness="0" Margin="2" CornerRadius="3"
                                        Background="{DynamicResource TextBrush}" Opacity="0.04" />
                                <StackPanel Margin="8">
                                    <Grid>
                                        <Image Source="{Binding PreviewUrl}" Width="130" Height="180" Stretch="Uniform"
                                               SnapsToDevicePixels="True" />
                                        <!-- Selected checkmark badge -->
                                        <Border x:Name="SelectedBadge" Width="26" Height="26" CornerRadius="13"
                                                Background="{DynamicResource TextBrush}"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                                Visibility="Collapsed">
                                            <TextBlock Text="&#10003;" FontWeight="Bold" FontSize="14"
                                                       Foreground="{DynamicResource TextBrushDark}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <!-- Already-added badge -->
                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="0,0,0,0"
                                                Background="{DynamicResource TextBrush}" Opacity="0.75"
                                                Visibility="{Binding AlreadyAdded, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="Already Added" HorizontalAlignment="Center" Margin="0,2"
                                                       FontSize="11" Foreground="{DynamicResource TextBrushDark}" />
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectedBadge" Property="Visibility" Value="Visible" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter TargetName="CardBorder" Property="BorderBrush">
                                    <Setter.Value>
                                        <SolidColorBrush Color="Transparent" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InnerBackground" Property="Opacity" Value="0.10" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource TextBrush}" />
                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="1" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsEnabled" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="InnerBackground" Property="Opacity" Value="0.02" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Game-match rows use a fully custom template for the same reason
            as CoverCardStyle above: Playnite's default ListBoxItem template
            forces its own foreground/selection colors that read as
            near-invisible dark-on-dark text against this dialog's
            background, so nothing here can rely on inherited defaults.
        -->
        <Style x:Key="GameMatchCardStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowBorder" BorderThickness="1" CornerRadius="4" Padding="10,8"
                                BorderBrush="{DynamicResource TextBrush}" Background="Transparent">
                            <TextBlock x:Name="RowText" Text="{Binding Name}" FontSize="14" Foreground="{DynamicResource TextBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource TextBrush}" />
                                <Setter TargetName="RowBorder" Property="Opacity" Value="0.9" />
                                <Setter TargetName="RowText" Property="Foreground" Value="{DynamicResource TextBrushDark}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource TextBrush}" />
                                <Setter TargetName="RowBorder" Property="Opacity" Value="0.10" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="16" LastChildFill="True">

        <!-- Search header -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox x:Name="SearchBox" Width="360" Padding="6,4" VerticalContentAlignment="Center"
                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                     KeyDown="SearchBox_KeyDown"
                     AutomationProperties.Name="Search SteamGridDB by game name" />
            <Button x:Name="SearchButton" Content="Search" Width="90" Margin="8,0,0,0" Padding="0,6"
                    IsDefault="True" Click="SearchButton_Click"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
        </StackPanel>

        <!-- Result count / cover limit banner -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="{Binding ResultCountText}" Opacity="0.75"
                       Visibility="{Binding ShowResults, Converter={StaticResource BoolToVisibilityConverter}}" />
            <TextBlock Text="{Binding GameMatchCountText}" Opacity="0.75"
                       Visibility="{Binding ShowGameMatches, Converter={StaticResource BoolToVisibilityConverter}}" />
            <TextBlock Text="SteamGridDB matched more than one game. Pick the one you meant:" Margin="0,2,0,0"
                       Visibility="{Binding ShowGameMatches, Converter={StaticResource BoolToVisibilityConverter}}" />
            <TextBlock Text="{Binding CoverLimitMessage}" FontWeight="Bold" Margin="0,2,0,0"
                       Visibility="{Binding IsAtCoverLimit, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>

        <!-- Bottom action bar -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Border DockPanel.Dock="Top" Height="1" Margin="0,0,0,10" Background="{DynamicResource TextBrush}" Opacity="0.15" />
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Opacity="0.8" Margin="0,8,0,0"
                       Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVisibilityConverter}}" />
            <TextBlock Text="{Binding SelectedCountText}" VerticalAlignment="Center" Opacity="0.85"
                       Visibility="{Binding ShowResults, Converter={StaticResource BoolToVisibilityConverter}}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Cancel" Width="90" Padding="0,6" IsCancel="True"
                        Click="CancelButton_Click" />
                <Button x:Name="AddSelectedButton" Content="Add Selected Cover" Width="160" Margin="8,0,0,0" Padding="0,6"
                        Click="AddSelectedButton_Click" IsEnabled="{Binding CanAddSelected}"
                        Visibility="{Binding ShowGameMatches, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                <Button x:Name="SelectGameMatchButton" Content="Select This Game" Width="160" Margin="8,0,0,0" Padding="0,6"
                        Click="SelectGameMatchButton_Click" IsEnabled="{Binding CanSelectGameMatch}"
                        Visibility="{Binding ShowGameMatches, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </DockPanel>

        <!-- Main content: loading / error / empty / results -->
        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Searching SteamGridDB..." HorizontalAlignment="Center" Margin="0,0,0,8" />
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" />
            </StackPanel>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380"
                        Visibility="{Binding ShowError, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Something went wrong" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" TextAlignment="Center" Opacity="0.85" />
            </StackPanel>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380"
                        Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="No covers found" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock Text="Try a different search term." TextWrapping="Wrap" TextAlignment="Center" Opacity="0.75" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ShowResults, Converter={StaticResource BoolToVisibilityConverter}}">
                <ListBox x:Name="ResultsList" ItemsSource="{Binding Results}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         SelectionMode="Single"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource CoverCardStyle}"
                         MouseDoubleClick="ResultsList_MouseDoubleClick">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </ScrollViewer>

            <!-- Game disambiguation: shown when the search query matched more than one game. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ShowGameMatches, Converter={StaticResource BoolToVisibilityConverter}}">
                <ListBox x:Name="GameMatchesList" ItemsSource="{Binding GameMatches}"
                         SelectedItem="{Binding SelectedGameMatch, Mode=TwoWay}"
                         SelectionMode="Single"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource GameMatchCardStyle}"
                         MouseDoubleClick="GameMatchesList_MouseDoubleClick" />
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
