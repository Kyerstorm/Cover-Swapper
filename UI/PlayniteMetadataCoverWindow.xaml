<Window x:Class="PluginCoverShuffle.UI.PlayniteMetadataCoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PluginCoverShuffle.UI"
        Title="Add Cover from Playnite Metadata" Height="360" Width="480" WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Window.Resources>
        <ui:AlreadyAddedLabelConverter x:Key="AlreadyAddedLabelConverter" />
        <ui:InverseBoolConverter x:Key="InverseBoolConverter" />
    </Window.Resources>
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}" Margin="0,0,0,8" Opacity="0.8" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Results}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" Margin="4" Padding="4" Width="140">
                            <StackPanel>
                                <Image Source="{Binding PreviewUrl}" Width="130" Height="150" Stretch="Uniform" />
                                <TextBlock Text="{Binding Asset.SourceId}" HorizontalAlignment="Center" Margin="0,2,0,0" FontSize="11" Opacity="0.7" />
                                <Button Margin="0,4,0,0"
                                        Content="{Binding AlreadyAdded, Converter={StaticResource AlreadyAddedLabelConverter}}"
                                        IsEnabled="{Binding AlreadyAdded, Converter={StaticResource InverseBoolConverter}}"
                                        Click="AddButton_Click"
                                        Tag="{Binding}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
