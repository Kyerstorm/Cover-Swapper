<Window x:Class="PluginCoverShuffle.UI.PlayniteMetadataCoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Cover from Playnite Metadata" Height="560" Width="680" MinHeight="420" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PluginCoverShuffle;component/UI/Resources/CoverShuffleTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Whole-card, click-to-select artwork tile. Mirrors the proven
                CoverCardStyle pattern from SteamGridDbSearchView.xaml (a
                ListBoxItem with a fully custom template so a single click
                anywhere on the card selects it), extended with an inline
                "Add" button per card - the button and whole-card selection
                are independent and both fire normally, the same way the
                Manage Covers cover cards combine selection with an inline
                favourite-toggle button.
            -->
            <Style x:Key="ArtworkCardStyle" TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Margin" Value="8" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Focusable" Value="True" />
                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleDescription}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="CardBorder" Width="180" BorderThickness="2" CornerRadius="6" Background="Transparent">
                                <Grid>
                                    <Border x:Name="InnerBackground" BorderThickness="0" Margin="2" CornerRadius="5"
                                            Background="{DynamicResource TextBrush}" Opacity="0.04" />
                                    <StackPanel Margin="10">
                                        <Grid HorizontalAlignment="Center" Width="{Binding ImageWidth}" Height="{Binding ImageHeight}" Margin="0,0,0,8">
                                            <Border CornerRadius="3" Background="{DynamicResource TextBrush}" Opacity="0.08" />
                                            <Image x:Name="ArtworkImage" Source="{Binding PreviewPath}" Stretch="Uniform" SnapsToDevicePixels="True" />

                                            <!-- Unavailable overlay: the artwork Playnite recorded no longer exists on disk. -->
                                            <TextBlock Text="&#9888; Unavailable" FontWeight="Bold" FontSize="12" Foreground="#FFC107"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="100"
                                                       Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />

                                            <!-- Added ribbon -->
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource TextBrush}" Opacity="0.85"
                                                    CornerRadius="0,0,6,0" Visibility="{Binding AlreadyAdded, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="&#10003; ADDED" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextBrushDark}" Margin="6,3" />
                                            </Border>
                                        </Grid>

                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Text="Playnite Metadata" FontSize="11" Opacity="0.65" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}" Margin="0,1,0,0" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                                   Foreground="#FFC107" Margin="0,2,0,0"
                                                   Visibility="{Binding StatusText, Converter={StaticResource BoolToVisibilityConverter}}" />

                                        <!-- Add / Try Again action: hidden once already added, since the ribbon above already says so. -->
                                        <Button x:Name="AddButton" Margin="0,8,0,0" Padding="0,6"
                                                Content="{Binding DisplayName, StringFormat='Add {0}'}"
                                                Click="AddButton_Click" Tag="{Binding}"
                                                IsEnabled="{Binding CanAdd}"
                                                Visibility="{Binding AlreadyAdded, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                        <Button x:Name="RetryButton" Margin="0,8,0,0" Padding="0,6" Content="Try Again"
                                                Click="AddButton_Click" Tag="{Binding}"
                                                Visibility="Collapsed" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource TextBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="False">
                                    <Setter TargetName="CardBorder" Property="BorderBrush">
                                        <Setter.Value>
                                            <SolidColorBrush Color="Transparent" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="InnerBackground" Property="Opacity" Value="0.10" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource TextBrush}" />
                                    <Setter TargetName="CardBorder" Property="BorderThickness" Value="1" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                    <Setter TargetName="ArtworkImage" Property="Opacity" Value="0.35" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter TargetName="AddButton" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="RetryButton" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="16" LastChildFill="True">

        <!-- Header: game identity is always resolved automatically, never typed by the user. -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <TextBlock Text="Add Cover from Playnite Metadata" Style="{StaticResource CoverShuffleTitleTextStyle}" FontSize="16" />
            <TextBlock Text="{Binding GameName}" Style="{StaticResource CoverShuffleTitleTextStyle}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="Choose artwork already available in Playnite" Style="{StaticResource CoverShuffleMutedTextStyle}" Margin="0,2,0,0" />
        </StackPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource CoverShuffleDividerStyle}" Margin="0,10,0,10" />

        <!-- Bottom action bar: Add All (or the reduced-slots variant), status, Close. -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Padding="14,6" Click="CloseButton_Click" IsCancel="True" />
            <Button x:Name="AddAllButton" DockPanel.Dock="Right" Margin="0,0,8,0" Padding="14,6"
                    Content="{Binding AddAllButtonText}" Click="AddAllButton_Click"
                    IsEnabled="{Binding CanAddAll}"
                    Visibility="{Binding ShowResults, Converter={StaticResource BoolToVisibilityConverter}}" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CoverShuffleMutedTextStyle}" VerticalAlignment="Center"
                       Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVisibilityConverter}}" />
        </DockPanel>

        <!-- Slots summary / cover limit banner, above the artwork grid. -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8"
                    Visibility="{Binding ShowResults, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding SlotsSummaryText}" Style="{StaticResource CoverShuffleBodyTextStyle}"
                       Visibility="{Binding IsAtCoverLimit, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
            <StackPanel Visibility="{Binding IsAtCoverLimit, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Cover limit reached" FontWeight="Bold" Foreground="#FFC107" />
                <TextBlock Text="{Binding CoverLimitMessage}" Style="{StaticResource CoverShuffleMutedTextStyle}" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Main content: loading / empty / error / results. -->
        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Loading Playnite artwork..." HorizontalAlignment="Center" Margin="0,0,0,8"
                           Style="{StaticResource CoverShuffleBodyTextStyle}" />
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" />
            </StackPanel>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380"
                        Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="No Playnite artwork available." FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"
                           Style="{StaticResource CoverShuffleBodyTextStyle}" />
                <TextBlock Text="This game does not currently have usable cover, background, or icon artwork."
                           TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource CoverShuffleMutedTextStyle}" />
            </StackPanel>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380"
                        Visibility="{Binding ShowError, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Couldn't load this game's artwork" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"
                           Style="{StaticResource CoverShuffleBodyTextStyle}" />
                <TextBlock Text="{Binding LoadErrorMessage}" TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource CoverShuffleMutedTextStyle}" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ShowResults, Converter={StaticResource BoolToVisibilityConverter}}">
                <ListBox x:Name="ResultsList" ItemsSource="{Binding Results}"
                         SelectionMode="Single"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource ArtworkCardStyle}"
                         MouseDoubleClick="ResultsList_MouseDoubleClick"
                         PreviewKeyDown="ResultsList_PreviewKeyDown">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
