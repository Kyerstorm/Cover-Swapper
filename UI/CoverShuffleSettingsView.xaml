<UserControl x:Class="PluginCoverShuffle.UI.CoverShuffleSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="clr-namespace:PluginCoverShuffle.UI"
             mc:Ignorable="d"
             d:DesignWidth="500">
    <UserControl.Resources>
        <ui:TimeSpanHoursConverter x:Key="TimeSpanHoursConverter" />
        <ui:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    </UserControl.Resources>
    <StackPanel Margin="20">
        <TextBlock Text="Cover Shuffle" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />
        <TextBlock Text="These are the defaults used for every game. Any game can override its own enabled state and interval from its right-click menu's &quot;Manage Covers&quot; window."
                   TextWrapping="Wrap" Margin="0,0,0,15" Opacity="0.8" />

        <CheckBox Content="Enable Cover Shuffle"
                  IsChecked="{Binding Settings.Enabled}"
                  ToolTip="Default state for newly-configured games. A game already enabled/disabled individually is unaffected."
                  Margin="0,0,0,10" />

        <CheckBox Content="Avoid consecutive duplicate covers"
                  IsChecked="{Binding Settings.AvoidConsecutiveDuplicates}"
                  ToolTip="When shuffling, never pick the same cover that is already showing (as long as the game has more than one enabled cover)."
                  Margin="0,0,0,10" />

        <CheckBox Content="Shuffle on Playnite startup"
                  IsChecked="{Binding Settings.ShuffleOnStartup}"
                  ToolTip="Apply any shuffle that came due while Playnite was closed, once, when Playnite starts. Playnite being closed for days never causes a pile-up of missed shuffles."
                  Margin="0,0,0,10" />

        <CheckBox Content="Shuffle on game launch"
                  IsChecked="{Binding Settings.ShuffleOnGameLaunch}"
                  ToolTip="Rotate the cover the moment a game launches. Uses the same schedule as the interval above, so this also resets when the next scheduled shuffle is due."
                  Margin="0,0,0,10" />

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="Shuffle interval (hours):" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox Text="{Binding Settings.Interval, Converter={StaticResource TimeSpanHoursConverter}}"
                     ToolTip="How often a game's cover rotates by default. Must be at least a few minutes; invalid values are rejected when you close settings."
                     Width="80" />
        </StackPanel>

        <TextBlock Text="New game behavior:" Margin="0,15,0,5"
                   ToolTip="What happens the first time Cover Shuffle sees a game it doesn't know yet (e.g. right after install)." />
        <StackPanel Orientation="Horizontal">
            <RadioButton Content="Do nothing" GroupName="NewGameBehavior" Margin="0,0,15,0"
                         ToolTip="Never touch a newly installed game automatically."
                         IsChecked="{Binding Settings.NewGameBehavior, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=DoNothing}" />
            <RadioButton Content="Ask" GroupName="NewGameBehavior" Margin="0,0,15,0"
                         ToolTip="Prompt whether to enable Cover Shuffle for the new game."
                         IsChecked="{Binding Settings.NewGameBehavior, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Ask}" />
            <RadioButton Content="Automatic" GroupName="NewGameBehavior"
                         ToolTip="Enable Cover Shuffle and pull in the game's existing Playnite cover art automatically. Never contacts SteamGridDB on its own."
                         IsChecked="{Binding Settings.NewGameBehavior, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Automatic}" />
        </StackPanel>

        <TextBlock Text="Notifications:" Margin="0,15,0,5"
                   ToolTip="How much scheduled shuffle activity is surfaced as a Playnite notification. Actions you trigger yourself (Shuffle Now, etc.) always show their result regardless of this setting." />
        <StackPanel Orientation="Horizontal">
            <RadioButton Content="Silent" GroupName="NotificationPreference" Margin="0,0,15,0"
                         ToolTip="Never notify, not even on failure."
                         IsChecked="{Binding Settings.NotificationPreference, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Silent}" />
            <RadioButton Content="Errors only" GroupName="NotificationPreference" Margin="0,0,15,0"
                         ToolTip="Notify only when a scheduled shuffle fails (e.g. a game's covers all went missing)."
                         IsChecked="{Binding Settings.NotificationPreference, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=NotifyOnErrorOnly}" />
            <RadioButton Content="Every shuffle" GroupName="NotificationPreference"
                         ToolTip="Notify every time a scheduled shuffle succeeds, plus any failures."
                         IsChecked="{Binding Settings.NotificationPreference, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=NotifyOnShuffle}" />
        </StackPanel>

        <TextBlock Text="SteamGridDB" FontSize="16" FontWeight="Bold" Margin="0,20,0,10" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" Opacity="0.8">
            <Run Text="Optional. Only needed for the &quot;Add Cover &#8594; SteamGridDB&quot; menu action; everything else works without it. Get a free key at" />
            <Hyperlink NavigateUri="https://www.steamgriddb.com/profile/preferences/api" RequestNavigate="Hyperlink_RequestNavigate">steamgriddb.com/profile/preferences/api</Hyperlink>
            <Run Text="." />
        </TextBlock>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="API key:" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox Text="{Binding Settings.SteamGridDbApiKey, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Never logged and never shown in error messages." Width="260" />
            <Button Content="Validate" Margin="10,0,0,0" Click="ValidateApiKeyButton_Click"
                    ToolTip="Checks the key against SteamGridDB right now, without saving it." />
        </StackPanel>
        <TextBlock Text="{Binding ApiKeyValidationStatus}" Margin="0,5,0,0" Opacity="0.8" />
    </StackPanel>
</UserControl>
