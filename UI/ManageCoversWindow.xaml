<Window x:Class="PluginCoverShuffle.UI.ManageCoversWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PluginCoverShuffle.UI"
        Title="Manage Covers" Height="420" Width="380" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ui:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Covers for this game" FontWeight="Bold" />
            <TextBlock Text="{Binding CoverCountText, StringFormat=' ({0})'}" Opacity="0.7" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="No covers yet. Use &quot;Add Cover&quot; from the game's right-click menu."
                   TextWrapping="Wrap" Opacity="0.7" Margin="0,10,0,0"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />
        <ListBox ItemsSource="{Binding Covers}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                        <Image Source="{Binding AbsoluteImagePath}" Width="60" Height="90" Stretch="Uniform" />
                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source}" FontWeight="Bold" />
                            <TextBlock Text="{Binding AddedAt, StringFormat='Added: {0:g}'}" />
                            <TextBlock Text="{Binding UsageCount, StringFormat='Used {0} time(s)'}" />
                            <Button Content="Remove" Width="80" HorizontalAlignment="Left" Margin="0,4,0,0"
                                    Click="RemoveButton_Click" Tag="{Binding CoverId}" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
