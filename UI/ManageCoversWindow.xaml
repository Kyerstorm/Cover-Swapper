<UserControl x:Class="PluginCoverShuffle.UI.ManageCoversWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:PluginCoverShuffle.UI"
             MinWidth="560" MinHeight="480">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PluginCoverShuffle;component/UI/Resources/CoverShuffleTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <ui:StatusDotBrushConverter x:Key="StatusDotBrushConverter" />
            <ui:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.CommandBindings>
        <!-- Handles the cover card's context menu / favourite commands (see CoverCardCommands.cs). -->
        <CommandBinding Command="{x:Static ui:CoverCardCommands.Preview}" Executed="PreviewCoverCommand_Executed" CanExecute="CoverCommand_CanExecute" />
        <CommandBinding Command="{x:Static ui:CoverCardCommands.SetAsCurrent}" Executed="SetAsCurrentCoverCommand_Executed" CanExecute="CoverCommand_CanExecute" />
        <CommandBinding Command="{x:Static ui:CoverCardCommands.Enable}" Executed="EnableCoverCommand_Executed" CanExecute="CoverCommand_CanExecute" />
        <CommandBinding Command="{x:Static ui:CoverCardCommands.Disable}" Executed="DisableCoverCommand_Executed" CanExecute="CoverCommand_CanExecute" />
        <CommandBinding Command="{x:Static ui:CoverCardCommands.Replace}" Executed="ReplaceCoverCommand_Executed" CanExecute="CoverCommand_CanExecute" />
        <CommandBinding Command="{x:Static ui:CoverCardCommands.Remove}" Executed="RemoveCoverCommand_Executed" CanExecute="CoverCommand_CanExecute" />
        <CommandBinding Command="{x:Static ui:CoverCardCommands.ToggleFavorite}" Executed="ToggleFavoriteCommand_Executed" CanExecute="CoverCommand_CanExecute" />
    </UserControl.CommandBindings>

    <DockPanel Margin="16" LastChildFill="True">

        <!-- Header: game name + large current-cover preview, clearly distinct from the collection thumbnails below. -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="96" Height="134" CornerRadius="4" Margin="0,0,14,0"
                    Background="{DynamicResource TextBrush}" Opacity="0.06">
                <Grid>
                    <Image Source="{Binding CurrentCover.AbsoluteImagePath}" Stretch="Uniform"
                           Visibility="{Binding HasCurrentCover, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Text="No current cover" FontSize="10" Opacity="0.6" TextAlignment="Center" TextWrapping="Wrap" Margin="6"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                               Visibility="{Binding HasCurrentCover, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding GameName}" Style="{StaticResource CoverShuffleTitleTextStyle}" />
                <TextBlock Text="Cover Shuffle" Style="{StaticResource CoverShuffleSectionLabelTextStyle}" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>
        <Border DockPanel.Dock="Top" Style="{StaticResource CoverShuffleDividerStyle}" Margin="0,0,0,14" />

        <!-- Status / scheduling / interval -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Status" Style="{StaticResource CoverShuffleSectionLabelTextStyle}" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,6,0"
                             Fill="{Binding IsEnabled, Converter={StaticResource StatusDotBrushConverter}}" />
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding EnabledSourceText}" Style="{StaticResource CoverShuffleMutedTextStyle}" Margin="0,4,0,0" />
                <Button x:Name="ToggleEnabledButton" Content="{Binding ToggleEnabledButtonText}" Width="90"
                        HorizontalAlignment="Left" Margin="0,6,0,0" Padding="0,4" Click="ToggleEnabledButton_Click" />
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Next shuffle" Style="{StaticResource CoverShuffleSectionLabelTextStyle}" />
                <TextBlock Text="{Binding NextShuffleText}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Interval (hours)" Style="{StaticResource CoverShuffleSectionLabelTextStyle}" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBox x:Name="IntervalBox" Width="56" Padding="4,2" />
                    <Button Content="Apply" Margin="6,0,0,0" Padding="6,2" Click="ApplyIntervalButton_Click" />
                </StackPanel>
                <TextBlock Text="{Binding IntervalSourceText}" Style="{StaticResource CoverShuffleMutedTextStyle}" Margin="0,4,0,0" />
                <Button Content="Reset to Global Defaults" Margin="0,6,0,0" Padding="0,4" HorizontalAlignment="Left"
                        IsEnabled="{Binding HasAnyOverride}" Click="ResetToGlobalDefaultsButton_Click" />
            </StackPanel>
        </Grid>

        <!-- Add Cover / Shuffle actions -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Border Style="{StaticResource CoverShuffleDividerStyle}" Margin="0,0,0,10" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="AddSteamGridDbButton" Content="+ SteamGridDB" Padding="8,5" Margin="0,0,8,0" Click="AddSteamGridDbButton_Click" />
                <Button x:Name="AddLocalFileButton" Content="+ Local File" Padding="8,5" Margin="0,0,8,0" Click="AddLocalFileButton_Click" />
                <Button x:Name="AddPlayniteMetadataButton" Content="+ Playnite" Padding="8,5" Click="AddPlayniteMetadataButton_Click" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Button Content="Shuffle Now" Padding="10,6" Margin="0,0,8,0" Click="ShuffleNowButton_Click" />
                <Button Content="Restore Original" Padding="10,6" Margin="0,0,8,0" IsEnabled="{Binding HasSavedOriginal}" Click="RestoreOriginalButton_Click" />
            </StackPanel>

            <!-- Per-selection action bar: appears only when exactly one cover is selected, so cards themselves never need nested buttons. -->
            <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="4" Background="{DynamicResource TextBrush}" Opacity="0.06"
                    Visibility="{Binding ShowSingleSelectionBar, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Selected cover:" Foreground="{DynamicResource TextBrush}" Opacity="0.75" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Content="Set as Current" Padding="8,4" Margin="0,0,6,0" Click="UseSelectedCoverButton_Click"
                            IsEnabled="{Binding CanApplySelectedCover}" />
                    <Button Content="Preview" Padding="8,4" Margin="0,0,6,0" Click="PreviewSelectedCoverButton_Click" />
                    <Button Content="Replace..." Padding="8,4" Margin="0,0,6,0" Click="ReplaceSelectedCoverButton_Click" />
                    <Button Content="Restore from SteamGridDB" Padding="8,4" Margin="0,0,6,0" Click="RestoreFromSteamGridDbForSelectedButton_Click"
                            Visibility="{Binding CanRestoreSelectedFromSteamGridDb, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button Content="Remove from Pool" Padding="8,4" Click="RemoveSelectedCoverButton_Click" />
                </StackPanel>
            </Border>

            <!-- Multi-select contextual action bar: only actions that make sense for the whole checked set. -->
            <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="4" Background="{DynamicResource TextBrush}" Opacity="0.06"
                    Visibility="{Binding HasMultipleSelectedCovers, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding SelectedCoverCount, StringFormat='{}{0} covers selected:'}"
                               Foreground="{DynamicResource TextBrush}" Opacity="0.75" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Content="Enable" Padding="8,4" Margin="0,0,6,0" Click="EnableSelectedCoversButton_Click"
                            Visibility="{Binding CanEnableSelectedCovers, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button Content="Disable" Padding="8,4" Margin="0,0,6,0" Click="DisableSelectedCoversButton_Click"
                            Visibility="{Binding CanDisableSelectedCovers, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button Content="Remove from Pool" Padding="8,4" Click="RemoveSelectedCoversButton_Click"
                            Visibility="{Binding CanRemoveSelectedCovers, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CoverShuffleBodyTextStyle}" Opacity="0.8" Margin="0,8,0,0"
                       Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>

        <!-- Covers -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Covers" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                <TextBlock Text="{Binding CoverCountText, StringFormat=' ({0})'}" Style="{StaticResource CoverShuffleSectionLabelTextStyle}" />
                <Button Content="Select All" Padding="6,2" Margin="12,0,0,0" Click="SelectAllCoversButton_Click"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                <Button Content="Clear Selection" Padding="6,2" Margin="6,0,0,0" Click="ClearCoverSelectionButton_Click"
                        Visibility="{Binding HasSelectedCover, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Top" Margin="0,10,0,0" HorizontalAlignment="Left"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="No covers yet" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                <TextBlock Text="Use one of the &quot;Add Cover&quot; buttons below to build this game's cover pool." TextWrapping="Wrap"
                           Style="{StaticResource CoverShuffleMutedTextStyle}" MaxWidth="360" Margin="0,4,0,0" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ListBox x:Name="CoversList" ItemsSource="{Binding Covers}"
                         SelectedItem="{Binding SelectedCover, Mode=TwoWay}"
                         SelectionMode="Extended"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource CoverShuffleCoverCardStyle}"
                         MouseDoubleClick="CoversList_MouseDoubleClick"
                         PreviewKeyDown="CoversList_PreviewKeyDown"
                         SelectionChanged="CoversList_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </ScrollViewer>
        </DockPanel>
    </DockPanel>
</UserControl>
