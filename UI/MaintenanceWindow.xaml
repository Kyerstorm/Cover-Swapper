<Window x:Class="PluginCoverShuffle.UI.MaintenanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PluginCoverShuffle.UI"
        Title="Cover Shuffle Maintenance" Height="480" Width="480" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ui:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}" Margin="0,0,0,10" FontWeight="Bold" />

        <TextBlock DockPanel.Dock="Top" Text="Nothing needs cleaning up right now."
                   Opacity="0.7" Margin="0,10,0,0"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />

        <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
            <TextBlock Text="Orphaned cover files (on disk, no matching record):" FontWeight="Bold" Margin="0,0,0,4" />
            <ListBox ItemsSource="{Binding OrphanedFiles}" Height="80" Margin="0,0,0,4" />
            <Button Content="Delete orphaned files..." HorizontalAlignment="Left" Click="DeleteOrphanedButton_Click" Margin="0,0,0,12" />

            <TextBlock Text="Invalid cover records (file missing):" FontWeight="Bold" Margin="0,0,0,4" />
            <ListBox ItemsSource="{Binding InvalidRecordDescriptions}" Height="80" Margin="0,0,0,4" />
            <Button Content="Remove invalid records..." HorizontalAlignment="Left" Click="RemoveInvalidButton_Click" Margin="0,0,0,12" />

            <TextBlock Text="Cache files (re-downloadable):" FontWeight="Bold" Margin="0,0,0,4" />
            <ListBox ItemsSource="{Binding CacheFiles}" Height="80" Margin="0,0,0,4" />
            <Button Content="Clear cache..." HorizontalAlignment="Left" Click="ClearCacheButton_Click" />
        </StackPanel>
    </DockPanel>
</Window>
